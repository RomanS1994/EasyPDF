{
  "name": "pdf-app",
  "private": true,
  "version": "1.0.0",
  "description": "PDF app with frontend contract generator and local backend for auth, plans, and orders",
  "type": "module",
  "scripts": {
    "dev": "node tools/dev.js",
    "dev:client": "vite",
    "dev:admin": "vite --config frontend/adminApp/vite.config.js",
    "dev:dispatcher": "vite --config frontend/dispatcherApp/vite.config.js",
    "dev:server": "npm --prefix backend run dev",
    "db:generate": "npm --prefix backend run db:generate",
    "db:migrate": "npm --prefix backend run db:migrate",
    "db:migrate:deploy": "npm --prefix backend run db:migrate:deploy",
    "admin:create": "npm --prefix backend run admin:create --",
    "hooks:install": "node tools/install-git-hooks.js",
    "prepare": "node tools/install-git-hooks.js",
    "secrets:check": "node tools/check-secrets.js",
    "build:driver": "vite build --config vite.config.js",
    "build:admin": "vite build --config frontend/adminApp/vite.config.js",
    "build:dispatcher": "vite build --config frontend/dispatcherApp/vite.config.js",
    "build": "npm run build:driver && npm run build:admin && npm run build:dispatcher",
    "preview": "vite preview",
    "start:server": "npm --prefix backend run start"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "postcss": "^8.4.41",
    "postcss-sort-media-queries": "^5.2.0",
    "vite": "^5.4.6"
  },
  "author": "Roman Stryzhka rstrizhko1994@gmail.com",
  "license": "ISC",
  "dependencies": {
    "@reduxjs/toolkit": "^2.11.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.14.2",
    "vite-plugin-full-reload": "^1.2.0",
    "vite-plugin-html-inject": "^1.1.2"
  },
  "packageManager": "npm@10.9.7"
}
