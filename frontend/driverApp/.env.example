# Frontend-only Vite environment variables.
# Do not put backend secrets, API secrets, or database credentials here.

VITE_API_BASE_URL=http://localhost:3001/api

# Optional public client header key. Must match backend API_KEY if enabled.
VITE_API_KEY=

# Optional Google Maps Places API key for address autocomplete.
VITE_GOOGLE_MAPS_API_KEY=

# Optional public support links shown for manual payment confirmation.
VITE_SUPPORT_WHATSAPP_URL=
VITE_SUPPORT_TELEGRAM_URL=

# Optional admin app entrypoint. Use a separate host/port for the back-office app.
VITE_ADMIN_APP_URL=http://localhost:4174/admin/accounts

# Optional driver app entrypoint used by the admin app. Leave empty to use same-origin paths in production.
VITE_DRIVER_APP_URL=
